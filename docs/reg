#!powershell

#ansiblerequires -csharputil ansible.basic
#requires -modules ansible.basic

$spec = @{
    options = @{
        sites = @{
            type = "list"
            elements = "str"
            required = $true
        }

        registry_path = @{
            type = "str"
            default = "HKLM:\SOFTWARE\Policies\Microsoft\Edge\SSLErrorOverrideAllowedForOrigins"
        }
    }

    supports_check_mode = $true
}

$module = [ansible.basic.ansiblemodule]::create($args, $spec)

try {

    $sites = $module.params.sites
    $path = $module.params.registry_path

    # make sure registry key exists
    if (-not (test-path $path)) {
        if (-not $module.checkmode) {
            new-item -path $path -force | out-null
        }
    }

    $existing_values = @()
    $max_index = 0

    $item = get-item -literalpath $path -erroraction silentlycontinue

    if ($item) {

        foreach ($prop in $item.property) {

            if ($prop -match '^\d+$') {

                $value = (get-itemproperty -literalpath $path -name $prop).$prop
                $existing_values += $value

                $index = [int]$prop
                if ($index -gt $max_index) {
                    $max_index = $index
                }
            }
        }
    }

    $next = $max_index + 1
    $added = @()

    foreach ($site in $sites) {

        if ($existing_values -contains $site) {
            continue
        }

        if (-not $module.checkmode) {

            new-itemproperty `
                -literalpath $path `
                -name $next `
                -value $site `
                -propertytype string `
                -force | out-null
        }

        $added += @{
            name = $next
            value = $site
        }

        $next++
    }

    $module.result.changed = ($added.count -gt 0)
    $module.result.registry_path = $path
    $module.result.added_entries = $added

    $module.exitjson()

}
catch {
    $module.failjson("edge ssl override update failed: $($_.exception.message)")
}
