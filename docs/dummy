#!powershell
# Module: rds_connection_broker_query
# Purpose:
# Query an RDS connection broker to determine which collections a
# session host belongs to and return the user groups assigned to them.

#AnsibleRequires -CSharpUtil Ansible.Basic
#Requires -Modules Ansible.Basic

$spec = @{
    options = @{
        session_host = @{
            type = "str"
            required = $true
        }
        connection_broker_name = @{
            type = "str"
            required = $true
        }

    }
    supports_check_mode = $true
}

$module = [Ansible.Basic.AnsibleModule]::Create($args, $spec)

function add_unique_string {
    param (
        [System.Collections.Generic.List[string]]$target_list,
        [string]$value
    )

    if ([string]::IsNullOrWhiteSpace($value)) {
        return
    }

    $clean_value = $value.Trim()

    if (-not $target_list.Contains($clean_value)) {
        [void]$target_list.Add($clean_value)
    }
}

function match_host_name {
    param (
        [string]$a,
        [string]$b
    )

    if ([string]::IsNullOrWhiteSpace($a) -or [string]::IsNullOrWhiteSpace($b)) {
        return $false
    }

    $a_norm = $a.Trim().ToLower()
    $b_norm = $b.Trim().ToLower()

    if ($a_norm -eq $b_norm) {
        return $true
    }

    $a_short = ($a_norm -split '\.')[0]
    $b_short = ($b_norm -split '\.')[0]

    return ($a_short -eq $b_short)
}

try {

    $session_host_name = $module.Params.session_host
$connection_broker_name = module.Params.connection_broker_name

    if ([string]::IsNullOrWhiteSpace($session_host_name)) {
        $module.FailJson("Parameter 'session_host' cannot be empty.")
    }

    $collections_found = New-Object 'System.Collections.Generic.List[string]'
    $resolved_groups = New-Object 'System.Collections.Generic.List[string]'
    $collection_details = New-Object 'System.Collections.Generic.List[object]'

    $collections = Get-RDSessionCollection -connectionbroker $connection_broker_name -ErrorAction Stop

    foreach ($collection in $collections) {

        $collection_name = $collection.CollectionName

        if ([string]::IsNullOrWhiteSpace($collection_name)) {
            continue
        }

        $hosts = Get-RDSessionHost -CollectionName $collection_name -ErrorAction Stop

        $session_hosts_in_collection = New-Object 'System.Collections.Generic.List[string]'
        $host_match = $false

        foreach ($s_host in $hosts) {

            $host_name = $s_host.SessionHost

            add_unique_string -target_list $session_hosts_in_collection -value $host_name

            if (match_host_name -a $host_name -b $session_host_name) {
                $host_match = $true
            }
        }

        if (-not $host_match) {
            continue
        }

        add_unique_string -target_list $collections_found -value $collection_name

        $config = Get-RDSessionCollectionConfiguration `
            -CollectionName $collection_name `
            -UserGroup `
            -ErrorAction Stop

        $collection_groups = New-Object 'System.Collections.Generic.List[string]'

        foreach ($group in $config.UserGroup) {

            add_unique_string -target_list $collection_groups -value $group
            add_unique_string -target_list $resolved_groups -value $group
        }

        $collection_details.Add(@{
            name = $collection_name
            session_hosts = $session_hosts_in_collection
            user_groups = $collection_groups
        }) | Out-Null
    }

    $module.Result.changed = $false
    $module.Result.session_host = $session_host_name
    $module.Result.collection_count = $collections_found.Count
    $module.Result.collections = $collections_found
    $module.Result.collection_details = $collection_details
    $module.Result.resolved_rdp_groups = $resolved_groups

    $module.ExitJson()

}
catch {
    $module.FailJson("Failed to query RDS collections. $($_.Exception.Message)")
}
