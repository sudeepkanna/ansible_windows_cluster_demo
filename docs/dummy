# Purpose:
# Run on one RDS Connection Broker and determine which collections a session host
# belongs to, then return all assigned user groups for those collections.

#AnsibleRequires -CSharpUtil Ansible.Basic
#Requires -Modules Ansible.Basic

$spec = @{
    options = @{
        session_host = @{
            type     = 'str'
            required = $true
        }
        connection_broker_name = @{
            type     = 'str'
            required = $true
        }
    }
    supports_check_mode = $true
}

$module = [Ansible.Basic.AnsibleModule]::Create($args, $spec)

function Add-UniqueString {
    param (
        [System.Collections.Generic.List[string]]$TargetList,
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return
    }

    $cleanValue = $Value.Trim()

    if (-not $TargetList.Contains($cleanValue)) {
        [void]$TargetList.Add($cleanValue)
    }
}

function Match-HostName {
    param (
        [string]$A,
        [string]$B
    )

    if ([string]::IsNullOrWhiteSpace($A) -or [string]::IsNullOrWhiteSpace($B)) {
        return $false
    }

    $aNorm = $A.Trim().ToLower()
    $bNorm = $B.Trim().ToLower()

    if ($aNorm -eq $bNorm) {
        return $true
    }

    $aShort = ($aNorm -split '\.')[0]
    $bShort = ($bNorm -split '\.')[0]

    return ($aShort -eq $bShort)
}

try {
    Import-Module RemoteDesktop -ErrorAction Stop
}
catch {
    $module.FailJson("Failed to import RemoteDesktop module. Ensure it is installed and available. $($_.Exception.Message)")
}

try {
    $sessionHostName = $module.Params.session_host
    $connectionBrokerName = $module.Params.connection_broker_name

    if ([string]::IsNullOrWhiteSpace($sessionHostName)) {
        $module.FailJson("Parameter 'session_host' cannot be empty.")
    }

    if ([string]::IsNullOrWhiteSpace($connectionBrokerName)) {
        $module.FailJson("Parameter 'connection_broker_name' cannot be empty.")
    }

    $collectionsFound = New-Object 'System.Collections.Generic.List[string]'
    $resolvedGroups = New-Object 'System.Collections.Generic.List[string]'
    $collectionDetails = New-Object 'System.Collections.Generic.List[object]'

    $collections = @(Get-RDSessionCollection -ConnectionBroker $connectionBrokerName -ErrorAction Stop)

    foreach ($collection in $collections) {
        $collectionName = [string]$collection.CollectionName

        if ([string]::IsNullOrWhiteSpace($collectionName)) {
            continue
        }

        $hosts = @(Get-RDSessionHost -CollectionName $collectionName -ConnectionBroker $connectionBrokerName -ErrorAction Stop)

        $sessionHostsInCollection = New-Object 'System.Collections.Generic.List[string]'
        $hostMatch = $false

        foreach ($sHost in $hosts) {
            $hostName = [string]$sHost.SessionHost
            Add-UniqueString -TargetList $sessionHostsInCollection -Value $hostName

            if (Match-HostName -A $hostName -B $sessionHostName) {
                $hostMatch = $true
            }
        }

        if (-not $hostMatch) {
            continue
        }

        Add-UniqueString -TargetList $collectionsFound -Value $collectionName

        $config = Get-RDSessionCollectionConfiguration `
            -CollectionName $collectionName `
            -ConnectionBroker $connectionBrokerName `
            -UserGroup `
            -ErrorAction Stop

        $collectionGroups = New-Object 'System.Collections.Generic.List[string]'

        foreach ($group in @($config.UserGroup)) {
            Add-UniqueString -TargetList $collectionGroups -Value ([string]$group)
            Add-UniqueString -TargetList $resolvedGroups -Value ([string]$group)
        }

        [void]$collectionDetails.Add(@{
            name          = $collectionName
            session_hosts = $sessionHostsInCollection.ToArray()
            user_groups   = $collectionGroups.ToArray()
        })
    }

    $module.Result.changed = $false
    $module.Result.session_host = $sessionHostName
    $module.Result.connection_broker_name = $connectionBrokerName
    $module.Result.collection_count = [int]$collectionsFound.Count
    $module.Result.collections = $collectionsFound.ToArray()
    $module.Result.collection_details = $collectionDetails.ToArray()
    $module.Result.resolved_rdp_groups = $resolvedGroups.ToArray()
    $module.Result.current_user = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
    $module.Result.current_host = $env:COMPUTERNAME

    $module.ExitJson()
}
catch {
    $module.FailJson("Failed to query RDS collections. $($_.Exception.Message)")
}
