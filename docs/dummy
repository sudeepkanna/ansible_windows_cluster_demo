#!powershell
# Copyright: (c) 2024
# Purpose:
# Query multiple RDS connection brokers to determine which collections
# a session host belongs to and return the merged user groups assigned
# to those collections. Brokers are tried in order until one succeeds.

#AnsibleRequires -CSharpUtil Ansible.Basic
#Requires -Modules Ansible.Basic

$spec = @{
    options = @{
        session_host = @{
            type = "str"
            required = $true
        }

        connection_broker_names = @{
            type = "list"
            elements = "str"
            required = $true
        }
    }

    supports_check_mode = $true
}

$module = [Ansible.Basic.AnsibleModule]::Create($args, $spec)

function Add-UniqueString {
    param(
        [System.Collections.Generic.List[string]]$TargetList,
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return
    }

    $clean = $Value.Trim()

    if (-not $TargetList.Contains($clean)) {
        [void]$TargetList.Add($clean)
    }
}

function Match-HostName {
    param(
        [string]$A,
        [string]$B
    )

    if ([string]::IsNullOrWhiteSpace($A) -or [string]::IsNullOrWhiteSpace($B)) {
        return $false
    }

    $aNorm = $A.Trim().ToLower()
    $bNorm = $B.Trim().ToLower()

    if ($aNorm -eq $bNorm) {
        return $true
    }

    $aShort = ($aNorm -split '\.')[0]
    $bShort = ($bNorm -split '\.')[0]

    return ($aShort -eq $bShort)
}

function Query-Broker {
    param(
        [string]$SessionHost,
        [string]$Broker
    )

    $collectionsFound = New-Object 'System.Collections.Generic.List[string]'
    $resolvedGroups = New-Object 'System.Collections.Generic.List[string]'
    $collectionDetails = New-Object 'System.Collections.Generic.List[object]'

    $collections = Get-RDSessionCollection -ConnectionBroker $Broker -ErrorAction Stop

    foreach ($collection in $collections) {

        $collectionName = $collection.CollectionName

        if ([string]::IsNullOrWhiteSpace($collectionName)) {
            continue
        }

        $hosts = Get-RDSessionHost `
            -CollectionName $collectionName `
            -ConnectionBroker $Broker `
            -ErrorAction Stop

        $sessionHosts = New-Object 'System.Collections.Generic.List[string]'
        $hostMatch = $false

        foreach ($host in $hosts) {

            $hostName = $host.SessionHost

            Add-UniqueString -TargetList $sessionHosts -Value $hostName

            if (Match-HostName -A $hostName -B $SessionHost) {
                $hostMatch = $true
            }
        }

        if (-not $hostMatch) {
            continue
        }

        Add-UniqueString -TargetList $collectionsFound -Value $collectionName

        $config = Get-RDSessionCollectionConfiguration `
            -CollectionName $collectionName `
            -ConnectionBroker $Broker `
            -UserGroup `
            -ErrorAction Stop

        $collectionGroups = New-Object 'System.Collections.Generic.List[string]'

        foreach ($group in $config.UserGroup) {

            Add-UniqueString -TargetList $collectionGroups -Value $group
            Add-UniqueString -TargetList $resolvedGroups -Value $group
        }

        $collectionDetails.Add(@{
            name = $collectionName
            session_hosts = $sessionHosts
            user_groups = $collectionGroups
        }) | Out-Null
    }

    return @{
        collection_count = $collectionsFound.Count
        collections = $collectionsFound
        collection_details = $collectionDetails
        resolved_rdp_groups = $resolvedGroups
    }
}

try {

    Import-Module RemoteDesktop -ErrorAction Stop

}
catch {
    $module.FailJson("Failed to load RemoteDesktop module: $($_.Exception.Message)")
}

try {

    $sessionHost = $module.Params.session_host
    $brokers = $module.Params.connection_broker_names

    if (-not $brokers -or $brokers.Count -eq 0) {
        $module.FailJson("connection_broker_names list is empty.")
    }

    $attempts = New-Object 'System.Collections.Generic.List[object]'
    $result = $null
    $successfulBroker = $null
    $lastError = $null

    foreach ($broker in $brokers) {

        try {

            $query = Query-Broker -SessionHost $sessionHost -Broker $broker

            $result = $query
            $successfulBroker = $broker

            $attempts.Add(@{
                broker = $broker
                status = "success"
            }) | Out-Null

            break
        }
        catch {

            $lastError = $_.Exception.Message

            $attempts.Add(@{
                broker = $broker
                status = "failed"
                error = $lastError
            }) | Out-Null
        }
    }

    if ($null -eq $result) {

        $module.FailJson(
            "All connection brokers failed. Last error: $lastError",
            @{
                attempts = $attempts
            }
        )
    }

    $module.Result.changed = $false
    $module.Result.session_host = $sessionHost
    $module.Result.successful_connection_broker = $successfulBroker
    $module.Result.connection_brokers_tried = $brokers
    $module.Result.attempts = $attempts
    $module.Result.collection_count = $result.collection_count
    $module.Result.collections = $result.collections
    $module.Result.collection_details = $result.collection_details
    $module.Result.resolved_rdp_groups = $result.resolved_rdp_groups

    $module.ExitJson()

}
catch {

    $module.FailJson("Module execution failed: $($_.Exception.Message)")
}
