---
- name: Test RDS pre-task logic locally
  hosts: session_hosts
  gather_facts: false

  vars:
    ansible_connection: winrm
    ansible_winrm_transport: ntlm
    ansible_port: 5986
    ansible_winrm_server_cert_validation: ignore

    ansible_become: true
    ansible_become_method: runas
    ansible_become_user: "{{ ansible_user }}"
    ansible_become_password: "{{ ansible_password }}"

  tasks:

    - name: Discover RDS connection brokers from registry
      pcs.windows.rds_session_host_discovery:
      register: rds_connection_broker_hosts

    - name: Show discovered brokers
      debug:
        var: rds_connection_broker_hosts.connection_brokers

    - name: Fail if no brokers discovered
      fail:
        msg: "No RDS connection brokers discovered"
      when: rds_connection_broker_hosts.connection_brokers | length == 0

    - name: Query RDS collections and groups from broker
      pcs.windows.rds_connection_broker_access:
        session_host: "{{ inventory_hostname }}"
        connection_broker_names: "{{ rds_connection_broker_hosts.connection_brokers }}"
      delegate_to: "{{ rds_connection_broker_hosts.connection_brokers[0] }}"
      vars:
        ansible_connection: psrp
        ansible_port: 5986
        ansible_psrp_cert_validation: ignore
        ansible_psrp_negotiate_delegate: true
      register: rds_query_result

    - name: Show full module output
      debug:
        var: rds_query_result

    - name: Extract resolved RDS groups
      set_fact:
        rds_groups: "{{ rds_query_result.resolved_rdp_groups | default([]) | unique | list }}"

    - name: Show final RDS groups
      debug:
        var: rds_groups
